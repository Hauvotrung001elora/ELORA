@model MonHocDetailsViewModel
@{
    ViewData["Title"] = Model.MonHoc.TenMonHoc;
    var countdownText = Model.SoNgayConLai switch
    {
        null => "Chưa đặt ngày thi",
        < 0 => $"Đã thi cách đây {-Model.SoNgayConLai.Value} ngày",
        0 => "Thi hôm nay!",
        _ => $"Còn {Model.SoNgayConLai.Value} ngày tới kỳ thi"
    };
}

<div class="mb-3">
    <a asp-action="Index" class="text-decoration-none text-muted small">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách môn học
    </a>
</div>

<div class="sf-card overflow-hidden mb-4">
    <div style="height: 8px; background-color: @Model.MonHoc.MaMau;"></div>
    <div class="p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="sf-color-dot" style="background-color: @Model.MonHoc.MaMau;"></span>
                    <h2 class="h4 fw-bold mb-0">@Model.MonHoc.TenMonHoc</h2>
                    <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary">@Model.DoKhoText</span>
                </div>
                <div class="d-flex flex-wrap gap-3 text-muted small">
                    <span><i class="bi bi-hourglass-split me-1"></i>@countdownText</span>
                    @if (Model.MonHoc.NgayThi.HasValue)
                    {
                        <span><i class="bi bi-calendar-event me-1"></i>Ngày thi: <strong>@Model.MonHoc.NgayThi.Value.ToString("dd/MM/yyyy")</strong></span>
                    }
                    <span><i class="bi bi-bullseye me-1"></i>Mục tiêu: <strong>@(Model.MonHoc.DiemMucTieu.HasValue ? $"{Model.MonHoc.DiemMucTieu:0.#}/10" : "Chưa đặt")</strong></span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="TaiLieu" asp-action="Upload" asp-route-maMonHoc="@Model.MonHoc.MaMonHoc" class="btn btn-sf-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-cloud-arrow-up me-1"></i>Tải tài liệu lên
                </a>
                <a asp-action="Edit" asp-route-id="@Model.MonHoc.MaMonHoc" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-pencil me-1"></i>Sửa
                </a>
                <form asp-action="Delete" asp-route-id="@Model.MonHoc.MaMonHoc" method="post" class="d-inline"
                      onsubmit="return confirm('Xóa môn học này sẽ xóa toàn bộ tài liệu và đề thi liên quan. Bạn chắc chắn?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-trash me-1"></i>Xóa
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="h5 fw-bold mb-0">
        <i class="bi bi-file-earmark-text me-2 text-primary"></i>Tài liệu học tập (@Model.TaiLieus.Count)
    </h3>
    <span class="text-muted small">Tổng cộng @Model.TongSoDeThi đề trắc nghiệm AI</span>
</div>

@if (!Model.TaiLieus.Any())
{
    <div class="sf-card p-5 text-center">
        <div class="sf-icon-box bg-info bg-opacity-10 text-info mx-auto mb-3">
            <i class="bi bi-file-earmark-arrow-up"></i>
        </div>
        <h4 class="h6 fw-bold mb-2">Môn học chưa có tài liệu nào</h4>
        <p class="text-muted small mb-3">Tải lên bài giảng (.pdf, .docx, .txt) để tự động trích xuất nội dung, tóm tắt và sinh đề thi bằng Gemini AI.</p>
        <a asp-controller="TaiLieu" asp-action="Upload" asp-route-maMonHoc="@Model.MonHoc.MaMonHoc" class="btn btn-sf-primary btn-sm rounded-pill px-4">
            <i class="bi bi-cloud-arrow-up me-1"></i>Tải tài liệu ngay
        </a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var tl in Model.TaiLieus)
        {
            var ext = System.IO.Path.GetExtension(tl.DuongDanFile).TrimStart('.').ToUpperInvariant();
            <div class="col-md-6">
                <div class="sf-card sf-card-hover p-4 h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex align-items-center gap-2 min-w-0">
                            <span class="badge bg-primary bg-opacity-10 text-primary">@ext</span>
                            <h4 class="h6 fw-bold mb-0 text-truncate" title="@tl.TieuDe">
                                <a asp-controller="TaiLieu" asp-action="Details" asp-route-id="@tl.MaTaiLieu" class="text-decoration-none text-dark">
                                    @tl.TieuDe
                                </a>
                            </h4>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(tl.TomTatAI))
                        {
                            <span class="badge rounded-pill bg-success bg-opacity-10 text-success flex-shrink-0">
                                <i class="bi bi-stars me-1"></i>Đã tóm tắt
                            </span>
                        }
                    </div>
                    <div class="text-muted small mb-3">
                        <i class="bi bi-clock me-1"></i>Tải lên: @tl.NgayTaiLen.ToString("dd/MM/yyyy HH:mm")
                        &bull; <strong>@tl.DeThis.Count</strong> đề thi
                    </div>
                    <div class="mt-auto d-flex justify-content-between align-items-center pt-2 border-top">
                        <div class="d-flex gap-2">
                            <a asp-controller="TaiLieu" asp-action="Details" asp-route-id="@tl.MaTaiLieu" class="btn btn-sm btn-light rounded-pill px-3">
                                Xem &amp; Tóm tắt AI
                            </a>
                            <a asp-controller="DeThi" asp-action="TaoDe" asp-route-maTaiLieu="@tl.MaTaiLieu" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-patch-question me-1"></i>Tạo đề AI
                            </a>
                        </div>
                        <form asp-controller="TaiLieu" asp-action="Delete" asp-route-id="@tl.MaTaiLieu" asp-route-returnMonHocId="@Model.MonHoc.MaMonHoc" method="post"
                              onsubmit="return confirm('Xóa tài liệu &quot;@tl.TieuDe&quot; và các đề thi liên quan?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa tài liệu">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
