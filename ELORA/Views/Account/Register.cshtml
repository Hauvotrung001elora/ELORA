@model RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    Layout = "_AuthLayout";
}

<div class="mb-4">
    <h3 class="fw-bold mb-1">Tạo tài khoản ELORA</h3>
    <p class="text-muted small mb-0">Đăng ký miễn phí dành cho sinh viên để trải nghiệm trợ lý học tập AI.</p>
</div>

<form asp-action="Register" method="post" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ReturnUrl" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0 small py-2" role="alert"></div>

    <div class="mb-3">
        <label asp-for="HoTen" class="form-label fw-medium small"></label>
        <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-person text-muted"></i></span>
            <input asp-for="HoTen" class="form-control" placeholder="Nguyễn Văn A" autocomplete="name" />
        </div>
        <span asp-validation-for="HoTen" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label fw-medium small"></label>
        <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-envelope text-muted"></i></span>
            <input asp-for="Email" class="form-control" placeholder="sinhvien@studyflow.vn" autocomplete="email" />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <label asp-for="Password" class="form-label fw-medium small"></label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-lock text-muted"></i></span>
                <input asp-for="Password" class="form-control" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="ConfirmPassword" class="form-label fw-medium small"></label>
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-shield-check text-muted"></i></span>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <div class="col-12 mt-1">
            <div class="form-text">Mật khẩu cần tối thiểu 6 ký tự, gồm chữ hoa, chữ thường và chữ số.</div>
        </div>
    </div>

    <button type="submit" class="btn btn-sf-primary w-100 py-2 rounded-3 mb-3">
        <i class="bi bi-person-plus me-1"></i>Tạo tài khoản
    </button>

    <p class="text-center text-muted small mb-0">
        Đã có tài khoản?
        <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold text-decoration-none">Đăng nhập</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
