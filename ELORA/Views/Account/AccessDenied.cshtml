@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-5">
        <div class="sf-card p-5 text-center">
            <div class="sf-icon-box bg-danger bg-opacity-10 text-danger mx-auto mb-3" style="width: 64px; height: 64px; font-size: 1.8rem;">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <h3 class="fw-bold mb-2">Truy cập bị từ chối</h3>
            <p class="text-muted small mb-4">
                Tài khoản của bạn không có quyền truy cập vào khu vực này. Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là nhầm lẫn.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-sf-primary px-4 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i>Quay lại Trang chủ
            </a>
        </div>
    </div>
</div>
