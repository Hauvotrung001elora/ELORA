@model TaiLieuIndexViewModel
@{
    ViewData["Title"] = "Tài liệu học tập";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="h4 fw-bold mb-1">Kho Tài liệu học tập</h2>
        <p class="text-muted small mb-0">Quản lý bài giảng PDF, Word, TXT đã trích xuất văn bản để tóm tắt và tạo đề thi AI.</p>
    </div>
    <a asp-action="Upload" asp-route-maMonHoc="@Model.FilterMaMonHoc" class="btn btn-sf-primary rounded-pill px-3">
        <i class="bi bi-cloud-arrow-up me-1"></i>Tải tài liệu lên
    </a>
</div>

<div class="sf-card p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-sm-8 col-md-5">
            <select name="maMonHoc" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả môn học --</option>
                @foreach (var opt in Model.MonHocOptions)
                {
                    <option value="@opt.Value" selected="@opt.Selected">@opt.Text</option>
                }
            </select>
        </div>
        @if (Model.FilterMaMonHoc.HasValue)
        {
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Xóa bộ lọc</a>
            </div>
        }
        <div class="col-auto ms-auto text-muted small">
            Hiển thị <strong>@Model.TaiLieus.Count</strong> tài liệu
        </div>
    </form>
</div>

@if (!Model.TaiLieus.Any())
{
    <div class="sf-card p-5 text-center">
        <div class="sf-icon-box bg-primary bg-opacity-10 text-primary mx-auto mb-3">
            <i class="bi bi-file-earmark-text"></i>
        </div>
        <h3 class="h5 fw-bold mb-2">Chưa có tài liệu nào</h3>
        <p class="text-muted small mb-4">Tải lên tệp .pdf, .docx hoặc .txt để bắt đầu tóm tắt kiến thức và sinh đề trắc nghiệm tự động.</p>
        <a asp-action="Upload" asp-route-maMonHoc="@Model.FilterMaMonHoc" class="btn btn-sf-primary rounded-pill px-4">
            <i class="bi bi-cloud-arrow-up me-1"></i>Tải tài liệu đầu tiên
        </a>
    </div>
}
else
{
    <div class="sf-card overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Tài liệu</th>
                        <th>Môn học</th>
                        <th>Trạng thái AI</th>
                        <th>Ngày tải lên</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tl in Model.TaiLieus)
                    {
                        var ext = System.IO.Path.GetExtension(tl.DuongDanFile).TrimStart('.').ToUpperInvariant();
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge bg-primary bg-opacity-10 text-primary">@ext</span>
                                    <a asp-action="Details" asp-route-id="@tl.MaTaiLieu" class="fw-semibold text-decoration-none text-dark">
                                        @tl.TieuDe
                                    </a>
                                </div>
                            </td>
                            <td>
                                @if (tl.MonHoc != null)
                                {
                                    <a asp-controller="MonHoc" asp-action="Details" asp-route-id="@tl.MaMonHoc" class="text-decoration-none d-inline-flex align-items-center gap-1 small text-dark">
                                        <span class="sf-color-dot" style="background-color: @tl.MonHoc.MaMau; width: 10px; height: 10px;"></span>
                                        @tl.MonHoc.TenMonHoc
                                    </a>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (!string.IsNullOrWhiteSpace(tl.TomTatAI))
                                    {
                                        <span class="badge rounded-pill bg-success bg-opacity-10 text-success">
                                            <i class="bi bi-stars me-1"></i>Đã tóm tắt
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary bg-opacity-10 text-secondary">Chưa tóm tắt</span>
                                    }
                                    <span class="badge rounded-pill bg-info bg-opacity-10 text-info">@tl.DeThis.Count đề thi</span>
                                </div>
                            </td>
                            <td class="text-muted small">@tl.NgayTaiLen.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@tl.MaTaiLieu" class="btn btn-sm btn-light rounded-pill px-3">Chi tiết</a>
                                    <a asp-controller="DeThi" asp-action="TaoDe" asp-route-maTaiLieu="@tl.MaTaiLieu" class="btn btn-sm btn-outline-primary rounded-pill px-3">Tạo đề AI</a>
                                    <form asp-action="Delete" asp-route-id="@tl.MaTaiLieu" method="post" class="d-inline"
                                          onsubmit="return confirm('Xóa tài liệu &quot;@tl.TieuDe&quot; và các đề thi liên quan?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Xóa">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
